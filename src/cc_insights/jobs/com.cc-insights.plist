<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. scripts/install-launchd.sh substitutes __CCI__ and __LOGDIR__ and
  writes the result to ~/Library/LaunchAgents/. Do not load this file directly.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cc-insights</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>__CCI__ init &amp;&amp; __CCI__ ingest &amp;&amp; __CCI__ derive &amp;&amp; __CCI__ sync auto</string>
    </array>

    <!-- `init` first, and it is not redundant. It applies pending migrations,
         and without it an upgrade that adds one stops this job dead: every
         other command refuses to touch a database older than the code, the
         refusal goes to ingest.err, and nobody reads ingest.err. Capture
         then stops silently while the agent logs it would have read are
         pruned on a rolling basis — the exact loss this job exists to
         prevent. `init` is idempotent and additive, so on every ordinary
         run it costs one query and changes nothing.

         `sync auto` LAST, and the ordering is the whole safety argument.
         Capture has already happened by the time it runs, so a server that
         is unreachable cannot cost a single event — ingest succeeds whether
         or not the network does. It is also the one step that exits 0 on
         failure, deliberately: a non-zero exit here would report the whole
         run as failed and hide a real ingest failure behind a network one.
         When nobody has run `cci login` it does nothing at all.

         Every 15 minutes. The job is cheap: a warm run reads only files whose
         size or mtime changed and takes ~0.04s. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/ingest.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/ingest.err</string>

    <!-- Stay out of the way of interactive work. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
