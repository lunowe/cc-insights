<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the WATCH job. `cci install` in watch mode substitutes
  __CCI__, __LOGDIR__ and __CONFIGDIR__ and writes the result to
  ~/Library/LaunchAgents/. Do not load this file directly.

  The difference from the 15-minute job: this one process stays up and follows
  the logs, so the database is seconds behind the agents rather than minutes.
  It is the same pipeline either way. Install one or the other, never both, or
  two writers will contend for the same database.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cc-insights.watch</string>

    <!-- `init` first so an upgrade that adds a migration does not turn this
         into a crashloop: `watch` refuses a database older than the code, and
         KeepAlive would restart it against ThrottleInterval forever while
         capturing nothing. `exec` hands the process back to watch afterwards,
         so KeepAlive still supervises watch itself rather than a shell.

         Quiet, because launchd's log would otherwise grow a line per cycle
         forever and nobody reads it. Errors still go to the .err file. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>__CCI__ init &amp;&amp; exec __CCI__ watch --quiet</string>
    </array>

    <!-- Same reason as the interval job: launchd does not read your shell,
         so without this an exported CC_INSIGHTS_HOME is invisible here and
         the watcher follows the logs into a database the CLI never opens.
         See com.cc-insights.plist for the long version. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CC_INSIGHTS_HOME</key>
        <string>__CONFIGDIR__</string>
    </dict>

    <!-- A long-running job, restarted if it dies. Throttled so a process that
         fails immediately (an unmigrated database, say) retries every half
         minute rather than spinning. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/watch.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/watch.err</string>

    <!-- Stay out of the way of interactive work. A scan is 50 ms of stat every
         two seconds; at Background priority that is invisible. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
